+        assert_eq!(stats.repaired, 1, "the slow git still repairs the row");
+        assert!(
+            ticks.load(Ordering::Relaxed) >= 5,
+            "the runtime kept running other tasks during the blocking git read (ticks: {})",
+            ticks.load(Ordering::Relaxed)
+        );
+    }
