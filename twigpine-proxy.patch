+        let at = scan_order_stamp(0);
+        state
+            .db
+            .create_repo(&crate::db::RepoRecord {
+                id: format!("{owner}/{name}"),
+                name: name.clone(),
+                owner_did: owner.clone(),
+                description: None,
+                is_public: false,
+                default_branch: "main".to_string(),
+                created_at: at,
+                updated_at: at,
