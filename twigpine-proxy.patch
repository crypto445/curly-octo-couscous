+             took {elapsed:?}"
+        );
+        assert!(
+            told.contains(&held) && told.contains(&format!("--scan {held}")),
+            "the still-held continuation and its resuming invocation must be surfaced, got: {told}"
+        );
+
+        m.assert_async().await;
+    }
