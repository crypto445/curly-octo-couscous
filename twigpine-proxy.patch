+        let observed = tokio::select! {
+            _ = crate::ipfs_pin::run_sweep_rearmed(
+                std::path::Path::new("/tmp"),
+                &state.git_bin,
+                git_timeout,
+                1,
+                std::time::Duration::ZERO,
+                std::time::Duration::ZERO,
+                &state.db,
+            ) => None,
