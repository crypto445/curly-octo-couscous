+            .execute(pool)
+            .await
+            .expect("hide pin_repo_sources");
+        let out = body().await;
+        sqlx::query("ALTER TABLE pin_repo_sources_hidden RENAME TO pin_repo_sources")
+            .execute(pool)
+            .await
+            .expect("restore pin_repo_sources");
+        out
