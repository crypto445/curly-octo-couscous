+    #[cfg(unix)]
+    #[test]
+    fn read_object_bounded_type_stage_fault_keeps_its_classification() {
+        use std::io::Write;
+        let td = tempfile::TempDir::new().unwrap();
+        let (bare, blob) = bare_repo_with_blob(td.path());
