+            "#!/bin/sh\n\
+             case \"$1\" in\n\
+               for-each-ref) : ;;\n\
+               rev-parse) echo deadbeef ;;\n\
+               rev-list) echo $$ > \"{pid}\"; echo start >> \"{log}\"; sleep 8; echo done >> \"{log}\" ;;\n\
+               *) : ;;\n\
+             esac\n\
+             exit 0\n",
+            pid = revlist_pid.display(),
+            log = walk_log.display()
