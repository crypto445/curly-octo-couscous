+            Ok(Ok(len)) => assert_eq!(len, N, "every distinct root tree returned"),
+            Ok(Err(e)) => panic!("root_tree_pairs errored: {e}"),
+            Err(_) => panic!("root_tree_pairs did not return within 30s"),
+        }
+    }
